# Configuración de Endpoints de AWS para BeeSense IoT
# Reemplace con la URL de su etapa de producción en Amazon API Gateway
VITE_AWS_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
VITE_AWS_IOT_ENDPOINT=xxxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com
VITE_AWS_REGION=us-east-1
VITE_COLMENAR_ID=COLMENAR-PAO-01

# Configuración del Servicio Puente Local de Alertas SMS (opcional en desarrollo)
VITE_SMS_BRIDGE_URL=http://localhost:8765

# Credenciales Privadas para el Backend / Servidor SMS (Definir en .env local o en AWS Lambda, NUNCA en el navegador)
VD_API_KEY=tu_api_key_privada_de_vozdigital
VD_TELEFONO=569XXXXXXXX
VD_MENSAJE=ALERTA!!! Tapa de colmena abierta - Colmenar Principal - Sede PAO
